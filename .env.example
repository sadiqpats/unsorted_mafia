# Unsorted Plans — Mafia Night
# Copy to .env (optional). Placeholders only — this app needs NO API keys or secrets.

# Port the Node server listens on
PORT=3001
# Interface to bind (0.0.0.0 lets phones on the same Wi-Fi connect)
HOST=0.0.0.0
# SQLite file for persisted rooms (use a persistent disk in production)
DATABASE_PATH=./data/mafia.db
# Delete rooms idle longer than this many hours
ROOM_TTL_HOURS=12
# Set to true behind a reverse proxy (Render, Fly, Railway, Nginx) so rate limits see real IPs
TRUST_PROXY=false
# Only needed if the client is served from a different origin than the server (comma-separated)
# CLIENT_ORIGIN=https://your-frontend.example.com
# Per-IP HTTP rate limit (room create/join). Guests on venue Wi-Fi often share one IP.
HTTP_RATE_BURST=150
HTTP_RATE_PER_SEC=3

# Website only (Vercel): address of the game server. Leave empty when one server serves everything.
# VITE_SERVER_URL=https://mafia-night.onrender.com

# Code required to HOST a game (players never need it). Set it in Render → Environment.
# Without it, production refuses to create rooms; local dev lets anyone host.
HOST_CODE=change-me
